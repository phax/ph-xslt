<!-- The invoice schema for XSD 1.0: complex and simple types with facets, an identity constraint -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="invoice" type="InvoiceType">
    <xs:unique name="lineID">
      <xs:selector xpath="lines/line"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <xs:complexType name="InvoiceType">
    <xs:sequence>
      <xs:element name="supplier" type="PartyType"/>
      <xs:element name="lines">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="line" type="LineType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="currency" type="CurrencyType" use="required"/>
    <xs:attribute name="date" type="xs:date" use="required"/>
  </xs:complexType>

  <xs:complexType name="PartyType">
    <xs:sequence>
      <xs:element name="name" type="NonEmptyString"/>
      <xs:element name="country" type="CountryType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TaxType">
    <xs:attribute name="rate" type="RateType" use="required"/>
    <xs:attribute name="reason" type="xs:token"/>
  </xs:complexType>

  <xs:complexType name="PeriodType">
    <xs:sequence>
      <xs:element name="start" type="xs:date"/>
      <xs:element name="end" type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="NonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CountryType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="EUR"/>
      <xs:enumeration value="USD"/>
      <xs:enumeration value="GBP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SkuType">
    <xs:restriction base="xs:token">
      <xs:pattern value="[A-Z]{3}-[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="QtyType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="1000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RateType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="0"/>
      <xs:enumeration value="7"/>
      <xs:enumeration value="19"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CatType">
    <xs:restriction base="xs:token">
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
      <xs:enumeration value="C"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="LineType">
    <xs:sequence>
      <xs:element name="item" type="NonEmptyString"/>
      <xs:element name="sku" type="SkuType"/>
      <xs:element name="qty" type="QtyType"/>
      <xs:element name="price" type="PriceType"/>
      <xs:element name="tax" type="TaxType"/>
      <xs:element name="note" type="xs:string" minOccurs="0"/>
      <xs:element name="period" type="PeriodType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="cat" type="CatType" use="required"/>
  </xs:complexType>

  <xs:simpleType name="PriceType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:totalDigits value="8"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
