<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.xpath</groupId>
    <artifactId>xpath-parent-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>xpath-conformance</artifactId>
  <packaging>jar</packaging>
  <name>xpath-conformance</name>
  <description>W3C QT3 (FOTS) conformance harness for the XPath 3.1 engine; test only, never deployed</description>
  <properties>
    <!-- Test harness only: never installed, deployed or published -->
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.helger.xpath</groupId>
      <artifactId>xpath-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-base</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-collection</artifactId>
    </dependency>
    <!-- fn:transform: the XSLT engine is found through the service loader -->
    <dependency>
      <groupId>com.helger.xpath</groupId>
      <artifactId>xslt-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Schema processors of the QT3 run (schema component model): the native validator is the default, Xerces-J the
         alternative (-Dxdm.schemaProvider=xerces) -->
    <dependency>
      <groupId>com.helger.xpath</groupId>
      <artifactId>xsd-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>xerces</groupId>
      <artifactId>xercesImpl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
