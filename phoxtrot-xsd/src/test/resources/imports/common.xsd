<!-- No target namespace: included into a namespaced schema it is a
     chameleon include and its components take on that namespace. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="Code">
    <xs:restriction base="xs:string"><xs:length value="2"/></xs:restriction>
  </xs:simpleType>
  <xs:element name="item" type="Code"/>
  <xs:element name="pair">
    <xs:complexType><xs:sequence><xs:element ref="item" maxOccurs="2"/></xs:sequence></xs:complexType>
  </xs:element>
  <xs:include schemaLocation="common2.xsd"/>
</xs:schema>
